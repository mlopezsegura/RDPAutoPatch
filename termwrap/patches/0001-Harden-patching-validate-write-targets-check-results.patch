+static bool isReadable(const MEMORY_BASIC_INFORMATION& mbi) {
+	if (mbi.State != MEM_COMMIT) return false;
+	if (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) return false;
+	return true;
+}
+
+// Copy every readable page of the image; unreadable pages stay zero in both snapshots
+static BYTE* snapshot(size_t base, size_t size) {
+	auto buf = (BYTE*)calloc(size, 1);
+	if (!buf) return NULL;
+	size_t off = 0;
+	while (off < size) {
+		MEMORY_BASIC_INFORMATION mbi;
+		if (!VirtualQuery((void*)(base + off), &mbi, sizeof(mbi))) break;
+		size_t regionEnd = (size_t)mbi.BaseAddress + mbi.RegionSize - base;
+		if (regionEnd > size) regionEnd = size;
+		if (isReadable(mbi)) memcpy(buf + off, (void*)(base + off), regionEnd - off);
+		off = regionEnd;
+	}
+	return buf;
+}
+
+static const char* sectionOf(PIMAGE_NT_HEADERS pNT, size_t rva, char* name) {
+	auto pSection = IMAGE_FIRST_SECTION(pNT);
+	for (WORD i = 0; i < pNT->FileHeader.NumberOfSections; i++)
+		if (rva >= pSection[i].VirtualAddress && rva < (size_t)pSection[i].VirtualAddress + pSection[i].Misc.VirtualSize) {
+			memcpy(name, pSection[i].Name, 8);
+			name[8] = 0;
+			return name;
+		}
+	return "?";
+}
