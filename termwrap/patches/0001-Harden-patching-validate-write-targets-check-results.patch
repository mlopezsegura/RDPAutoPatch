+// Print every run of bytes changed by patch(), so results can be compared between builds
+static int printDiff(size_t base, PIMAGE_NT_HEADERS pNT, const BYTE* before, const BYTE* after, size_t size) {
+	int runs = 0;
+	char name[9];
+	for (size_t i = 0; i < size; i++) {
+		if (before[i] == after[i]) continue;
+		size_t end = i + 1, last = i;
+		// merge changed bytes separated by fewer than 4 unchanged bytes into one run
+		while (end < size && end - last <= 4) {
+			if (before[end] != after[end]) last = end;
+			end++;
+		}
+		printf("PATCH rva=%08zX %-8s old=", i, sectionOf(pNT, i, name));
+		for (size_t j = i; j <= last; j++) printf("%02X", before[j]);
+		printf(" new=");
+		for (size_t j = i; j <= last; j++) printf("%02X", after[j]);
+		printf("\n");
+		runs++;
+		i = last;
+	}
+	return runs;
+}
