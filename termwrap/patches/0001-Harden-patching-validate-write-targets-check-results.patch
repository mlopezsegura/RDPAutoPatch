+// OutputDebugString "<name>: <msg> rva=0x<hex>\n" without depending on the CRT
+static void dbgRva(const char* name, const char* msg, size_t addr) {
+	char buf[160];
+	size_t n = 0;
+	for (const char* p = name; *p && n < 96; p++) buf[n++] = *p;
+	for (const char* p = msg; *p && n < 136; p++) buf[n++] = *p;
+	for (const char* p = " rva=0x"; *p; p++) buf[n++] = *p;
